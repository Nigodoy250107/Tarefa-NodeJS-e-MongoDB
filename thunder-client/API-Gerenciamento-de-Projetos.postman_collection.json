      "name": "Sucesso (01-12)",
      "item": [
        {
          "name": "01 - Listar projetos",
          "description": "Expected HTTP 200. Retorna os projetos persistidos no MongoDB.",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projetos",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Resultado esperado', function () { pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Buscar projeto por codigo",
          "description": "Expected HTTP 200. Retorna o projeto PRJ001.",
